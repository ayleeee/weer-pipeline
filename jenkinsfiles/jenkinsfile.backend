@Library('weer-shared-library') _

pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
        timestamps()
    }

    tools {
        jdk 'jdk21'
    }

    environment {
        SERVICE_NAME = 'weer-backend'
        SOURCE_REPO_URL = 'https://github.com/Woori-Emergency/WeER_backend.git'
        SOURCE_BRANCH = 'main'
        DOCKERFILE_PATH = 'Dockerfile'
        REGISTRY_CREDENTIALS_ID = 'registry-credentials'
        IMAGE_REPOSITORY = 'registry.example.com/weer/backend'
        GITOPS_UPDATE_JOB = 'Update-K8S-Manifest'
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    checkoutSource(
                        repositoryUrl: env.SOURCE_REPO_URL,
                        branch: env.SOURCE_BRANCH
                    )
                }
            }
        }

        stage('Build And Test') {
            steps {
                script {
                    buildApplication(
                        installCommand: 'chmod +x gradlew',
                        buildCommand: './gradlew clean build --stacktrace',
                        buildCommandWithoutTests: './gradlew clean build -x test --stacktrace',
                        testEnabled: true
                    )
                }
            }
        }

        stage('Build Image') {
            steps {
                script {
                    def shortCommit = env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'unknown'
                    env.IMAGE_TAG = "${env.SERVICE_NAME}-${env.BUILD_NUMBER}-${shortCommit}"
                    env.IMAGE_DIGEST = publishDockerImage(
                        imageRepository: env.IMAGE_REPOSITORY,
                        imageTag: env.IMAGE_TAG,
                        dockerfilePath: env.DOCKERFILE_PATH,
                        credentialsId: env.REGISTRY_CREDENTIALS_ID,
                        buildArgs: [
                            JAR_FILE: 'build/libs/*.jar'
                        ]
                    )
                }
            }
        }

        stage('Trigger GitOps Handoff') {
            steps {
                script {
                    triggerGitOpsUpdate(
                        jobName: env.GITOPS_UPDATE_JOB,
                        serviceName: env.SERVICE_NAME,
                        imageRepository: env.IMAGE_REPOSITORY,
                        imageTag: env.IMAGE_TAG,
                        imageDigest: env.IMAGE_DIGEST,
                        sourceCommit: env.GIT_COMMIT,
                        waitForCompletion: false
                    )
                }
            }
        }
    }

    post {
        always {
            script {
                recordPipelineMetadata(
                    serviceName: env.SERVICE_NAME,
                    imageRepository: env.IMAGE_REPOSITORY,
                    imageTag: env.IMAGE_TAG,
                    imageDigest: env.IMAGE_DIGEST,
                    sourceCommit: env.GIT_COMMIT,
                    buildResult: currentBuild.currentResult
                )
                echo "[${env.SERVICE_NAME}] pipeline result: ${currentBuild.currentResult}"
                cleanWs()
            }
        }
    }
}
