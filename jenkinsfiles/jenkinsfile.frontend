@Library('weer-shared-library') _

pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
        timestamps()
    }

    tools {
        nodejs 'node18'
    }

    environment {
        SERVICE_NAME = 'weer-frontend'
        SOURCE_REPO_URL = 'https://github.com/Woori-Emergency/WeER_frontend.git'
        SOURCE_BRANCH = 'main'
        AWS_CREDENTIALS_ID = 'aws-credentials'
        AWS_REGION = 'ap-northeast-2'
        S3_BUCKET_URI = 's3://weer-frontend-placeholder'
        CLOUDFRONT_DISTRIBUTION_ID = 'CLOUDFRONT_DISTRIBUTION_ID_PLACEHOLDER'
        BUILD_DIR = 'build'
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    checkoutSource(
                        repositoryUrl: env.SOURCE_REPO_URL,
                        branch: env.SOURCE_BRANCH
                    )
                }
            }
        }

        stage('Build And Test') {
            steps {
                script {
                    buildApplication(
                        installCommand: 'npm ci',
                        buildCommand: 'npm run build',
                        testCommand: 'npm test -- --watchAll=false',
                        testEnabled: false
                    )
                }
            }
        }

        stage('Publish Static Site') {
            steps {
                script {
                    publishStaticSite(
                        buildDir: env.BUILD_DIR,
                        bucketUri: env.S3_BUCKET_URI,
                        distributionId: env.CLOUDFRONT_DISTRIBUTION_ID,
                        credentialsId: env.AWS_CREDENTIALS_ID,
                        region: env.AWS_REGION
                    )
                }
            }
        }
    }

    post {
        always {
            script {
                recordPipelineMetadata(
                    serviceName: env.SERVICE_NAME,
                    artifactType: 'static-site',
                    artifactPath: env.BUILD_DIR,
                    deploymentTarget: env.S3_BUCKET_URI,
                    sourceCommit: env.GIT_COMMIT,
                    buildResult: currentBuild.currentResult
                )
                echo "[${env.SERVICE_NAME}] pipeline result: ${currentBuild.currentResult}"
                cleanWs()
            }
        }
    }
}
